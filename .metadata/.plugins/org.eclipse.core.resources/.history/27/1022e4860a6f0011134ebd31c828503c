#ifndef FUNKTIONEN_ANALOGOUT_H_
#define FUNKTIONEN_ANALOGOUT_H_

void currentOut(float current_mA)
{
    // Strom auf 4...20 mA begrenzen
    if(current_mA < 4.0f)
        current_mA = 4.0f;

    if(current_mA > 20.0f)
        current_mA = 20.0f;

    // Gewünschte VIN berechnen
    float vin = (current_mA / 1000.0f) * RSET / 10.0f;

    // DAC-Code berechnen
    uint16_t dacValue = (uint16_t)((vin / DAC_REF) * DAC_MAX + 0.5f);

    // SPI-Daten vorbereiten
    uint8_t txData[3];

    txData[0] = 0x00;                     // Normal Mode
    txData[1] = (dacValue >> 8) & 0xFF;   // MSB
    txData[2] = dacValue & 0xFF;          // LSB

	HAL_GPIO_WritePin(SPI3_CS1_GPIO_Port, SPI3_CS1_Pin, GPIO_PIN_RESET);
	status = HAL_SPI_Transmit(&hspi3, txData, sizeof(txData), HAL_MAX_DELAY); // Drittes Argument bedeutet Anzahl Datenframes!
	HAL_GPIO_WritePin(SPI3_CS1_GPIO_Port, SPI3_CS1_Pin, GPIO_PIN_SET);

	/*if(status != HAL_OK)
	 {
	 Error_Handler();
	 }*/
}


#endif /* FUNKTIONEN_ANALOGOUT_H_ */
