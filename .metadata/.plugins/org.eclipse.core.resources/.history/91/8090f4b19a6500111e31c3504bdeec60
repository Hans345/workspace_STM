#ifndef FUNKTIONEN_STATEMACHINE_H_
#define FUNKTIONEN_STATEMACHINE_H_

/**
 * @brief States für Statemachine
 */
typedef enum
{
	IDLE,
    READY,
    SAMPLING,
    FFT,
    TRANSFER
} State_t;

/**
 * @brief Events für Statemachine
 */
typedef enum
{
    EVENT_NONE,
    EVENT_BUTTON
} Event_t;

void StateMachine(State_t *state, Event_t event)
{
    switch (*state)
    {
        case IDLE:
            *state = READY;
            break;

        case READY:
			_print("Start Monitoringsystem\r\n");
			_print("*****************************\r\n");
			// Clear PUTTY Konsole
			HAL_UART_Transmit(&huart1, clear, sizeof(clear) - 1, 1000);
			if(event = EVENT_BUTTON)
			{
				*state = SAMPLING;
			}
            break;

        case SAMPLING:
        	_print("ADC Sampling\r\n");
        	break;

        default:
            *state = STATE_OFF;
            break;
    }
}

#endif /* FUNKTIONEN_STATEMACHINE_H_ */
